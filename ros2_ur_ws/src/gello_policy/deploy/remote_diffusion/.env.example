# Absolute server path containing config.json, model.safetensors, and the saved
# policy pre/postprocessor JSON files. The directory is mounted read-only.
CHECKPOINT_DIR=/path/to/server/project-workspace/models/diffusion_banana_in_pot_joint
# Persistent cache for policies that construct external encoders/tokenizers
# (for example MultiTaskDiT's CLIP models) during checkpoint loading.
# Set the Hugging Face cache root: it must contain hub/models--..., because
# Compose mounts only its hub subdirectory and deliberately excludes token.
HF_CACHE_DIR=/path/to/server/project-workspace/huggingface-cache

# Select one physical GPU exposed by the server for this run.
GPU_DEVICE=0

# Published on server loopback by default. Keep this value for SSH tunnelling.
INFERENCE_BIND_IP=127.0.0.1
INFERENCE_PORT=50051

IMAGE_TAG=dev
LEROBOT_COMMIT=8a74e0ac6d01706d67fddfed682a09d694d9c8c0
# Comma-separated LeRobot extras. FM/MultiTaskDiT uses multi-task-dit.
# Rebuild the image after changing this for another policy family.
LEROBOT_EXTRAS=multi-task-dit
MODEL_ID=Bigenlight/diffusion_banana_in_pot_joint
CHECKPOINT_REVISION=sha256:d4722b60caee5d76d004a37e16b2d7adecc1668f79703259ea7260fc9c723c57
DIFFUSION_SCHEDULER=DDIM
DIFFUSION_NUM_INFERENCE_STEPS=10
DIFFUSION_N_ACTION_STEPS=32

# Generic LeRobot policy-server profile (examples; select values for checkpoint).
POLICY_INFERENCE_PORT=50052
EXPECTED_POLICY_TYPE=multi_task_dit
# Compute before startup with:
# python3 -m policy_server.checkpoint_identity "$CHECKPOINT_DIR"
EXPECTED_CHECKPOINT_REVISION=sha256:REPLACE_WITH_COMPUTED_MANIFEST
POLICY_TASK=put the cube in the cup
POLICY_TASK_MODE=required
POLICY_WARMUP_STATE=[3.106,-1.817,1.653,-1.618,-1.628,-3.195,0.0]
POLICY_CONFIG_OVERRIDES={"num_integration_steps":10,"n_action_steps":24}
EXTERNAL_IMAGE_SIZE=native
