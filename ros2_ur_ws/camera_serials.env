# Lab default RealSense serials for cam1 / cam2  (ONE place for both shell and Python).
#
# Read by:
#   - _resolve_camera_serials.sh :: load_camera_serial_defaults  (run_recorder.sh)
#   - gello_recorder.camera_defaults                             (gello_recorder_gui,
#                                                                 EEF collection GUI)
# An exported CAM1_SERIAL / CAM2_SERIAL always wins over this file, and
# GELLO_CAMERA_SERIALS_FILE=<path> points both readers at a different file.
#
# Use the DEVICE serial_number (what `rs-enumerate-devices -s` prints under
# "Serial Number"), NOT the ASIC serial the kernel/journalctl shows -- a
# realsense2_camera node bound to an ASIC serial starts but publishes nothing.
# Format: plain KEY=VALUE lines; '#' starts a comment.
#
# On a different rig: edit the two values below, or export the env vars.
CAM1_SERIAL=143322071682
CAM2_SERIAL=143322072540
# cam1 = SCENE camera (table front-on), cam2 = WRIST camera (gripper in view).
