FROM python:3.10.14-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    XLA_PYTHON_CLIENT_PREALLOCATE=false

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY serl_ur_infra/docker/requirements-rlpd-receive.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --requirement /tmp/requirements.lock

WORKDIR /opt/gello
COPY third_party/hil-serl/serl_launcher/serl_launcher \
    /opt/gello/third_party/hil-serl/serl_launcher/serl_launcher
COPY serl_ur_infra /opt/gello/serl_ur_infra

ENV PYTHONPATH=/opt/gello/serl_ur_infra:/opt/gello/third_party/hil-serl/serl_launcher

ENTRYPOINT ["python", "/opt/gello/serl_ur_infra/scripts/run_rlpd_receive_server.py"]
