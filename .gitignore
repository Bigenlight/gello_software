# keep each top level section alphabetical
# keep each item within the sections alphabetical

# large files
*.png
*.gif

# mac
*.DS_Store

# misc
*logs*
*runs*
*tb_logs*
tea_debug.log
*wandb*
*wandb_logs*
# ...but a source file is not a run artifact.  `*wandb*` above exists for W&B
# run directories and it matches by NAME anywhere in the tree, so a test module
# about W&B was silently un-addable: `git add` reported it ignored rather than
# staging it, and a `git commit -a` would simply have left it out.  Re-include
# tracked Python under the test directory only; run artifacts never live there.
!serl_ur_infra/tests/*wandb*.py
outputs/*

# GELLO->UR7e diagnostic recorder output is large binary data (mp4/h5) and is
# no longer tracked here -- recordings are archived on Google Drive instead
# (see ros2_ur_ws/gello_logs/README.md, which stays tracked as a pointer).
!ros2_ur_ws/gello_logs/
ros2_ur_ws/gello_logs/*
!ros2_ur_ws/gello_logs/README.md

# python
*__pycache__
*.egg-info
*.hypothesis
*.ipynb_checkpoints
*.mypy_cache
*.pyc

# vim
*.swp
MUJOCO_LOG.TXT

#ros
# stray colcon artifacts if you build from the repo root instead of ros2_ur_ws/
/build/
/install/
/log/
ros2/build/
ros2/install/
ros2/log/
# ROS2 workspace build artifacts (ros2_ur_ws/.gitignore also covers build|install|log)
ros2_ur_ws/act_venv/

# robot packages
third_party/i2rt/

# 3D Model Files
*.stl
# MujocoRobotServer가 실행 시 생성하는 런타임 산출물
arena.xml

# Claude Code 로컬 산출물 (공유 설정 .claude/settings.json은 계속 추적)
.claude/settings.local.json
.claude/worktrees/
